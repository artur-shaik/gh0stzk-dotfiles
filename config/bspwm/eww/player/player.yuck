;; Vars ;;
(deflisten music
  :initial '{"title":"","artist":"","status":"Stopped","art":"","position":"0:00","length":"0:00","positions":0,"lengths":0,"shuffle":"Off","loop":"Off","player":"MPD"}'
  "music-state-listen.sh")

;; Widgets ;;
(defwidget shuffle [color action status]
	(eventbox
		:cursor "pointer"
		(button
			:onclick action
			:style "color: ${color}"
			:tooltip status
			"󰒟"
		)
	)
)

(defwidget loop [icon color status action]
	(eventbox
		:cursor "pointer"
		(button
			:onclick action
			:style "color: ${color}"
			:tooltip status
			icon
		)
	)
)

(defwidget player []
	(box
		:class "player"
		:space-evenly false
		(box
			:class "player-art"
			:style "background-image: linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.55)), url('${music.art}')"
			(box
				:class "player-info"
				:space-evenly false
				:orientation "v"
				:spacing 10
				(box
					:class "top-icons"
					(box
						:space-evenly false
						:spacing 10
						(shuffle
							:action {music.player == "MPD" ? "mpc random" : "playerctl -p ${music.player} shuffle toggle"}
							:color {music.shuffle == "On" ? "#81ae5f" : "#b8bfe5"}
							:status {music.shuffle}
						)
						(loop
							:action {music.loop == "None" ? "playerctl -p ${music.player} loop playlist" :
							music.loop == "Off" ? "mpc repeat on" :
							music.loop == "On" ? "mpc repeat off" :
							music.loop == "Playlist" ? "playerctl -p ${music.player} loop track" : "playerctl -p ${music.player} loop none"}
							:icon  {music.music.loop == "Track" ? "󰑘" :
							music.loop == "Playlist" || music.loop == "On" ? "󰑖" : "󰑗"}
							:color {music.music.loop == "Playlist" || music.loop == "Track" || music.loop == "On" ? "#81ae5f" : "#b8bfe5"}
							:status {music.loop}
						)
					)
					(box
						(button
							:class {music.player != "spotify" ? "mpd-icon" : "spotify-icon"}
							:halign "end"
							{music.player != "spotify" ? "󰎆" : "󰓇"}
						)
					)
				)
				(label
					:class "player-title"
					:halign "start"
					:text {music.title}
					:wrap true
					:xalign 0
				)
				(label
					:class "player-artist"
					:halign "start"
					:text {music.artist}
					:wrap true
				)

				(box
					:space-evenly false
					:orientation "v"
					:valign "end"
					:spacing 6
					:vexpand true
					(box
						:class "player-bar"
						(eventbox
							:cursor "pointer"
							(scale
								:onchange {music.player == "MPD" ? "mpc seek {}" : "playerctl -p ${music.player} position {}"}
								:min 0
								:max {music.lengths == 0 ? 100 : music.lengths}
								:value {music.positions}
							)
						)
					)
					(box
						:class "player-position"
						:space-evenly false
						:valign "end"
						:spacing 3
						(label
							:class "player-time"
							:text {music.position}
						)
						(label :class "player-time" :text "/")
						(label
							:class "player-time"
							:text {music.length}
						)
					)
				)
			)
		)
		(box
			:class "player-controls"
			:orientation "v"
			:valign "center"
			:hexpand true
			:space-evenly false
			:spacing 20
			(eventbox
				:cursor "pointer"
				(button
					:class "player-previous"
					:onclick "MediaControl --previous"
					"󰒮"
				)
			)
			(eventbox
				:cursor "pointer"
				(button
					:class "player-toggle"
					:onclick "MediaControl --toggle"
					{music.status == "Playing" ? "󰏤" : music.status == "Paused" ? "󰐊" : "󰓛"}
				)
			)
			(eventbox
				:cursor "pointer"
				(button
					:class "player-next"
					:onclick "MediaControl --next"
					"󰒭"
				)
			)
      (eventbox
				:cursor "pointer"
				(button
					:class "min"
					:onclick "lyrics-popup.sh &"
					"󰦰"
				)
			)
      (eventbox
				:cursor "pointer"
				(button
					:class "min"
					:onclick "eww -c ~/.config/bspwm/eww open --toggle music"
					"󰅙"
				)
			)
		)
	)
)

;; Windows ;;
(defwindow music
  :geometry
  (geometry
    :y "-7%"
    :anchor "bottom center"
  )
	:wm-ignore false
  (player)
)
