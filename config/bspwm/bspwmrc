# Set environment variables
export PATH="$HOME/.config/bspwm/bin:$PATH"
export XDG_CURRENT_DESKTOP='bspwm'
# ash: удалённый mpd для mpc/MediaControl/eww-плеера
[ -r "$HOME/.mpd_host" ] && export MPD_HOST="$(cat "$HOME/.mpd_host")"
[ -r "$HOME/.mpd_port" ] && export MPD_PORT="$(cat "$HOME/.mpd_port")"
## Fix java applications
export _JAVA_AWT_WM_NONREPARENTING=1

#  ╦ ╦╔═╗╦═╗╦╔═╔═╗╔═╗╔═╗╔═╗╔═╗╔═╗
#  ║║║║ ║╠╦╝╠╩╗╚═╗╠═╝╠═╣║  ║╣ ╚═╗
#  ╚╩╝╚═╝╩╚═╩ ╩╚═╝╩  ╩ ╩╚═╝╚═╝╚═╝

MonitorSetup

# ash: hotplug мониторов — пере-раскладка десктопов и спасение окон
# (без этого отключённый монитор остаётся фантомом с окнами)
"$HOME"/.config/bspwm/bin/monitor-hotplug.sh &

# ash: ВРЕМЕННО — логгер для отлова спонтанного краша X при смене темы.
# Логи ~/theme-debug/latest/. Снять после диагностики (этот блок + theme-step-вызовы).
"$HOME"/.local/bin/theme-crash-logger &

# ash: вертикальные гапы по layout (tiled: 20px, monocle: впритык)
pkill -f 'layout-gaps.sh' 2>/dev/null
"$HOME"/.config/bspwm/bin/layout-gaps.sh &

# ash: чёрный ящик окон (лог в ~/.cache/bspwm-window-log)
pkill -f 'bspc subscribe node_add node_remove' 2>/dev/null
"$HOME"/.config/bspwm/bin/window-blackbox &

# ash: до-расстановка окон с поздним WM_CLASS (qutebrowser и пр.) — external_rules
# при маппинге видит пустой class и промахивается. Подписчик чинит на node_add.
pkill -f 'late-desktop-rules.sh' 2>/dev/null
"$HOME"/.config/bspwm/bin/late-desktop-rules.sh &

#  ╔╗ ╔═╗╔═╗╦ ╦╔╦╗  ╔═╗╔═╗╔╗╔╔═╗╦╔═╗
#  ╠╩╗╚═╗╠═╝║║║║║║  ║  ║ ║║║║╠╣ ║║ ╦
#  ╚═╝╚═╝╩  ╚╩╝╩ ╩  ╚═╝╚═╝╝╚╝╚  ╩╚═╝

bspc config external_rules_command "${HOME}"/.config/bspwm/bin/ExternalRules

bspc config remove_unplugged_monitors true
bspc config merge_overlapping_monitors true
bspc config window_gap                5
bspc config split_ratio               0.51
bspc config single_monocle            false  # ash: иначе одиночное окно всегда monocle и layout-gaps не работают

bspc config automatic_scheme          longest_side
bspc config initial_polarity          second_child
bspc config removal_adjustment        true

bspc config focus_follows_pointer     true
bspc config pointer_follows_focus     false
bspc config pointer_follows_monitor   true
bspc config pointer_motion_interval   7
bspc config pointer_modifier          mod4
bspc config pointer_action1           move
bspc config pointer_action2           resize_side
bspc config pointer_action3           resize_corner

#  ╔═╗╦ ╦╔╦╗╔═╗╔═╗╔╦╗╔═╗╦═╗╔╦╗
#  ╠═╣║ ║ ║ ║ ║╚═╗ ║ ╠═╣╠╦╝ ║
#  ╩ ╩╚═╝ ╩ ╚═╝╚═╝ ╩ ╩ ╩╩╚═ ╩

run() {
  if ! pidof -q "$1"; then
    "$@" &
  fi
}

# Set system vars for polybar
"$HOME"/.config/bspwm/bin/SetSysVars

# Launch sxhkd daemon (ash: наши хоткеи, не gh0stzk)
run sxhkd -c "${HOME}"/.config/sxhkd/sxhkdrc

# ash: блокировка экрана (xss-lock+xsecurelock). РАНЬШЕ была в .xinitrc, но
# gdm-autologin запускает сессию `bspwm` НАПРЯМУЮ (Exec=bspwm, .dmrc Session=bspwm)
# и .xinitrc НЕ читает → lock не стартовал после апдейта. `xset s` = idle-таймер
# для xss-lock. pgrep-гард — bspwmrc гоняется и на reload (без дублей).
xset s 300 5
pgrep -x xss-lock >/dev/null || \
    xss-lock -n /usr/local/libexec/xsecurelock/dimmer -l -- \
    env XSECURELOCK_SAVER="${HOME}"/bin/xsecurelock-saver-time XSECURELOCK_NO_COMPOSITE=1 xsecurelock &

# ash: демоны что РАНЬШЕ были в .xinitrc (gdm-сессия его НЕ читает — см. выше).
# nextcloud/kdeconnectd идут через XDG-autostart, тут НЕ дублировать. mpd — удалённый.
# run() = pidof-гард, без дублей на reload.
# udiskie=python-скрипт, indicator=comm обрезан 15симв → pidof/run() их НЕ ловит
# (плодил бы дубли на reload) → гард через pgrep -f по строке команды.
pgrep -f '\budiskie\b'             >/dev/null || udiskie -n -T &
pgrep -f '\bkdeconnect-indicator\b' >/dev/null || kdeconnect-indicator &
run kbdd
run barrier

# ash: раскладка us,ru (hotplug-восстановление — user-сервис kbd-layout.service)
setxkbmap -layout 'us,ru' -option 'grp:alt_space_toggle,grp_led:caps,ctrl:nocaps'
systemctl --user start kbd-layout.service 2>/dev/null

# Load current theme
"${HOME}"/.config/bspwm/bin/Theme.sh

# Launch picom
run picom --config "${HOME}"/.config/bspwm/config/picom.conf

# Launch xsettingsd
run xsettingsd --config="${HOME}"/.config/bspwm/config/xsettingsd >/dev/null 2>&1

# Launch eww daemon
pidof -q eww || { eww -c "${HOME}"/.config/bspwm/eww daemon & }

# ash: clipcat/lxpolkit нет в репах Tumbleweed, не используются
# run clipcatd
# run lxpolkit

