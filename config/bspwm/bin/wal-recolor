#!/usr/bin/env python3
# ash: перекраска конфигов райса в wal-палитру.
# Каждый #RRGGBB (и #AARRGGBB — альфа сохраняется) заменяется ближайшим
# цветом wal (16 цветов + bg/fg, метрика — RGB-дистанция).
# Работает от pristine-копии <file>.orig (создаётся при первом прогоне),
# чтобы повторные прогоны не дрейфовали.
import re
import sys
from pathlib import Path

WAL = Path.home() / ".cache/wal/colors.sh"


def load_wal():
    palette = []
    for line in WAL.read_text().splitlines():
        m = re.match(r"^(?:export )?(\w+)='(#[0-9a-fA-F]{6})'", line)
        if m:
            palette.append(m.group(2))
    return list(dict.fromkeys(palette))  # uniq, порядок сохранён


def rgb(h):
    return tuple(int(h[i:i + 2], 16) for i in (1, 3, 5))


def nearest(h, palette):
    r, g, b = rgb(h)
    return min(palette, key=lambda p: sum((a - c) ** 2 for a, c in zip(rgb(p), (r, g, b))))


def recolor(text, palette):
    def repl(m):
        alpha, color = m.group(1) or "", m.group(2)
        return "#" + alpha + nearest("#" + color, palette)[1:]
    return re.sub(r"#([0-9a-fA-F]{2})?([0-9a-fA-F]{6})\b", repl, text)


def main():
    if not WAL.exists():
        sys.exit(0)  # wal не прогонялся — оставляем как есть
    palette = load_wal()
    if not palette:
        sys.exit(0)
    for arg in sys.argv[1:]:
        f = Path(arg)
        if not f.exists():
            continue
        orig = f.with_suffix(f.suffix + ".orig")
        if not orig.exists():
            orig.write_text(f.read_text())
        f.write_text(recolor(orig.read_text(), palette))


if __name__ == "__main__":
    main()
