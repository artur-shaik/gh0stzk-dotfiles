WIDGET_DIR="$HOME/.config/bspwm/eww"

# ash: индекс монитора под курсором (порядок = xrandr connected) для eww --screen
pointer_screen() {
    eval "$(xdotool getmouselocation --shell 2>/dev/null)"  # X, Y
    idx=0
    xrandr 2>/dev/null | grep -w connected | grep -oE '[0-9]+x[0-9]+\+[0-9]+\+[0-9]+' | \
    while IFS='x+' read -r w h ox oy; do
        if [ "${X:-0}" -ge "$ox" ] && [ "${X:-0}" -lt "$((ox + w))" ] && \
           [ "${Y:-0}" -ge "$oy" ] && [ "${Y:-0}" -lt "$((oy + h))" ]; then
            echo "$idx"; return
        fi
        idx=$((idx + 1))
    done
}

case "$1" in
	--menu)
		RofiLauncher --launcher
		;;
	--rice)
		RiceSelector
		;;
	--terminal)
		Term --terminal
		;;
	--floating)
		Term --floating
		;;
	--update)
		Term --update
		;;
	--checkupdates)
		Term --checkupdates
		;;
	--netmanager)
		NetManagerDM
		;;
	--pass)
		RofiPass
		;;
	--bluetooth)
		rofi-bluetooth
		;;
	--clipboard)
		clipcat-menu
		;;
	--screenshot)
		ScreenShoTer
		;;
	--powermenu)
		PowerMenu
		;;
	--android)
		AndroidMount
		;;
	--keyboard)
		KeyBoardL
		;;
	--yazi)
		Term --yazi
		;;
	--nvim)
		Term --nvim
		;;
	--music)
		Term --music
		;;
	--fetch)
		Term --fetch
		;;
	--scratch)
		Bspwm-ScratchPad
		;;
		# Apps
	--filemanager)
		thunar
		;;
	--browser)
		firefox
		;;
	--editor)
		geany
		;;
	--telegram)
		telegram-desktop
		;;
	--whats)
		firefox -new-tab https://web.whatsapp.com/
		;;
	--soundcontrol)
		pavucontrol
		;;
		# Eww Widgets
	--KeyHelp)
		eww -c "$WIDGET_DIR" open --toggle csheet
		;;
	--usercard)
		eww -c "$WIDGET_DIR" open --toggle launchermenu --screen "${SCREEN:-$(pointer_screen)}"
		;;
	--player)
		eww -c "$WIDGET_DIR" open --toggle music --screen "${SCREEN:-$(pointer_screen)}"
		;;
	*)
		echo "Invalid Option"
		;;
esac
